# Copy this file to ".env" and fill in your values.

# From the ElevenLabs dashboard: your agent's ID (Agents -> your agent -> Settings).
# The agent must be PUBLIC with authentication DISABLED for this simple setup.
VITE_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Leave EMPTY in dev (calls are proxied to the local mock Vista server).
# In production set this to the real Apigee host, e.g.:
#   VITE_VISTA_BASE=https://api-dev.maflec.com
VITE_VISTA_BASE=
