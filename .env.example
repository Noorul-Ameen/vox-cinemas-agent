# Optional public client identifier override. The prototype agent ID already has
# a public fallback in vite.config.js so StackBlitz can start without this file.
VITE_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Leave blank for the validated local UAE snapshot. A production value must be
# a safe server-side proxy/base that injects Vista credentials. Never put Vista
# tokens, API keys, ElevenLabs secrets, card data, or signed tokens in VITE_*.
VITE_VISTA_BASE=
