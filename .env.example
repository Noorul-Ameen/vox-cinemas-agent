# Optional public client identifier override. Leave this blank to use the
# validated public fallback in vite.config.js. If you set it, use only the
# approved public agent ID from config/elevenlabs-agent-contract.json.
VITE_AGENT_ID=

# Leave blank for the validated local UAE snapshot. A production value must be
# a safe server-side proxy/base that injects Vista credentials. Never put Vista
# tokens, API keys, ElevenLabs secrets, card data, or signed tokens in VITE_*.
VITE_VISTA_BASE=

# Cloudflare Pages snapshot-mode builds require no secret environment values.
# Both variables above are compiled into browser JavaScript and must remain
# public-safe. Keep server credentials only in the server-side proxy/secret store.
